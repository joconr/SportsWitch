{
  "manifest_version": 3,
  "name": "SportsWitch",
  "version": "4.4.0",
  "description": "Switch among sports streams, mute ads and fill breaks with trivia, scores, fantasy and music. Ad detection runs locally.",
  "homepage_url": "https://github.com/joconr/SportsWitch",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "debugger",
    "cookies",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify_media.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "mark-ad": {
      "suggested_key": {"default": "Alt+Shift+A"},
      "description": "That's an ad"
    },
    "mark-game": {
      "suggested_key": {"default": "Alt+Shift+G"},
      "description": "That's the game"
    }
  },
  "action": {
    "default_title": "SportsWitch 4.4.0",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
